<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!--
      MonoGame.Framework.DesktopGL is intentionally flow-through. The adapter exposes types
      implemented in terms of it, so a game project that references only the library must
      still receive the runtime assemblies at build, publish and run time. Marking it
      PrivateAssets=All previously produced projects that compiled but failed to start.
      Gum is deliberately absent: the Gum integration lives in Adapters/Gum/MonoGame so a
      game that does not use Gum never has to ship it.
    -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\MonoGameLibrary.Core.csproj" />
    <ProjectReference Include="..\..\Extensions\MonoGameLibrary.Extensions.csproj" />
  </ItemGroup>
</Project>