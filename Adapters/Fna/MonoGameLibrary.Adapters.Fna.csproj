<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MonoGameLibrary.Adapters.Fna</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      FNA.NET is intentionally flow-through: the adapter exposes types implemented in terms of it, so
      a game that references only the library must still receive the runtime assemblies at build,
      publish and run time. Its native libraries arrive as a dependency of it and only publish needs
      them.
    -->
    <PackageReference Include="FNA.NET" Version="2.2.11.2602" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\MonoGameLibrary.Core.csproj" />
    <ProjectReference Include="..\..\Extensions\MonoGameLibrary.Extensions.csproj" />
  </ItemGroup>
</Project>
